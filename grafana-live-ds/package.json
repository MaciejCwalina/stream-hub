{
  "name": "home-llm-live",
  "version": "1.0.0",
  "description": "Grafana streaming datasource for the home LLM server stream-hub",
  "scripts": {
    "build": "node build.mjs && node -e \"require('fs').copyFileSync('src/plugin.json','dist/plugin.json')\"",
    "dev": "node build.mjs --watch"
  },
  "dependencies": {
    "@grafana/data": "^13.0.0",
    "@grafana/runtime": "^13.0.0",
    "@grafana/ui": "^13.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0",
    "@types/react": "^19.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
